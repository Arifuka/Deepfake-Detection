        <!-- Data & Privacy: Privacy and policy -->
        <string name="setting_privacy_and_policy">Privacy and policy</string>
        <string name="privacy_policy_header">How EdgeGuard protects your data</string>
        <string name="privacy_policy_point_1">EdgeGuard only detects videos you watch in TikTok application. It does not detect videos anywhere else on your phone.</string>
        <string name="privacy_policy_point_2">EdgeGuard analyzes these videos directly on your device. Nothing is uploaded or shared online.</string>
        <string name="privacy_policy_point_3">EdgeGuard needs access to the TikTok videos you watch so it can check them for signs of AI manipulation.</string>
        <string name="privacy_policy_point_4">EdgeGuard does not collect, store, or share your videos or photos, not even with the EdgeGuard team.</string>
        <string name="privacy_policy_point_5">Your detection history stays on your device, and only you can see it.</string>
        <string name="privacy_policy_point_6">EdgeGuard was created to protect you, not to monitor you.</string>

        <!-- Learn & Get Help: User manual -->
        <string name="setting_user_manual">User manual</string>
        <string name="manual_step_1">Open the EdgeGuard app and click on the switch next to \"Protection\".</string>
        <string name="manual_step_2">Open TikTok and watch videos as usual.</string>
        <string name="manual_step_3">EdgeGuard checks every video automatically.</string>
        <string name="manual_step_4">When EdgeGuard finds signs that a video may be fake, it will let you know right away with a notification on your screen.</string>

